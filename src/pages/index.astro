---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Hr from "@components/Hr.astro";
---

<Layout>
  <Header />

  <main id="main-content">
    <section id="hero">
      <h1>Dariusz Dobrowolski</h1>

      <p class="subtitle">
        Dr inż. · Politechnika Świętokrzyska
      </p>

      <p>
        Pracownik naukowo-dydaktyczny Katedry Technologii Informatycznych
        Wydziału Zarządzania i Modelowania Komputerowego Politechniki
        Świętokrzyskiej.
      </p>

      <p>
        Zainteresowania naukowe obejmują m.in. inżynierię danych, technologie
        informatyczne, zarządzanie wiedzą, analizę danych oraz zastosowania
        sztucznej inteligencji w zarządzaniu i przemyśle.
      </p>

      <Hr />

      <h2>Kontakt</h2>

      <p>
        <strong>Politechnika Świętokrzyska</strong><br />
        Wydział Zarządzania i Modelowania Komputerowego<br />
        Katedra Technologii Informatycznych
      </p>

      <p>
        <a href="mailto:ddobrowolski@tu.kielce.pl">
          ddobrowolski@tu.kielce.pl
        </a>
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #hero {
    @apply pb-12 pt-8;
  }

  #hero h1 {
    @apply my-4 text-3xl font-bold sm:my-8 sm:text-5xl;
  }

  #hero p {
    @apply my-4 max-w-3xl leading-7;
  }

  #hero .subtitle {
    @apply text-lg font-medium;
  }

  #hero h2 {
    @apply mb-4 mt-8 text-2xl font-semibold;
  }

  #hero a {
    @apply underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }
</style>
